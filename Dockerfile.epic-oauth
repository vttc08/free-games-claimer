FROM node:22-bookworm-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      ca-certificates \
      python3 \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/apprise-venv \
    && /opt/apprise-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/apprise-venv/bin/pip install --no-cache-dir apprise

WORKDIR /app
COPY package*.json ./

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PATH=/opt/apprise-venv/bin:$PATH
RUN npm ci --omit=dev

COPY . .
RUN mkdir -p /app/data

ENV EPIC_AUTH_FILE=/app/data/epic-auth.json \
    EPIC_OAUTH_REPORT_FILE=/app/data/epic-free-games-status.json
CMD ["node", "epic-oauth.js"]
