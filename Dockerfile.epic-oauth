FROM node:22-bookworm-slim

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ARG DEBIAN_FRONTEND=noninteractive
ARG COMMIT=""
ARG BRANCH=""
ARG NOW=""

RUN apt-get update \
    && apt-get install --no-install-recommends -y \
      ca-certificates \
      python3 \
      python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/apprise-venv \
    && /opt/apprise-venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/apprise-venv/bin/pip install --no-cache-dir apprise

WORKDIR /app
COPY package*.json ./

ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV PATH=/opt/apprise-venv/bin:$PATH
RUN npm ci --omit=dev

COPY . .
RUN mkdir -p /app/data

ENV COMMIT=${COMMIT} \
    BRANCH=${BRANCH} \
    NOW=${NOW}

LABEL org.opencontainers.image.title="free-games-claimer" \
      org.opencontainers.image.name="free-games-claimer" \
      org.opencontainers.image.description="Epic OAuth helper and free-game library checker" \
      org.opencontainers.image.url="https://github.com/vttc08/free-games-claimer" \
      org.opencontainers.image.source="https://github.com/vttc08/free-games-claimer" \
      org.opencontainers.image.revision=${COMMIT} \
      org.opencontainers.image.ref.name=${BRANCH} \
      org.opencontainers.image.base.name="node:22-bookworm-slim" \
      org.opencontainers.image.created=${NOW} \
      org.opencontainers.image.version="latest"

ENV EPIC_AUTH_FILE=/app/data/epic-auth.json \
    EPIC_OAUTH_REPORT_FILE=/app/data/epic-free-games-status.json
CMD ["node", "epic-oauth.js"]
