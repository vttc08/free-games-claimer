{
  "name": "free-games-claimer",
  "version": "1.4.0",
  "description": "Automatically claims free games on the Epic Games Store, Amazon Prime Gaming and GOG.",
  "homepage": "https://github.com/vogler/free-games-claimer",
  "repository": {
    "type": "git",
    "url": "https://github.com/vogler/free-games-claimer.git"
  },
  "author": "Ralf Vogler",
  "license": "AGPL-3.0-only",
  "main": "index.js",
  "scripts": {
    "docker:build": "docker build -f Dockerfile.epic-oauth . -t vttc08/free-games-claimer",
    "docker:epic-oauth": "docker build -f Dockerfile.epic-oauth . -t vttc08/free-games-claimer",
    "docker": "cross-env-shell docker run --rm -it -p 3989:3989 -v \\\"$INIT_CWD/data\\\":/app/data --name fgc-epic-oauth vttc08/free-games-claimer",
    "epic-oauth": "node epic-oauth.js",
    "lint": "npx eslint ."
  },
  "type": "module",
  "engines": {
    "node": ">=17"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "enquirer": "^2.4.1",
    "fingerprint-injector": "^2.1.66",
    "lowdb": "^7.0.1",
    "otplib": "^12.0.1",
    "playwright-firefox": "^1.52.0",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin-js": "^4.2.0",
    "eslint": "^9.26.0"
  }
}
